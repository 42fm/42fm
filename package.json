{
  "name": "42fm",
  "version": "0.2.0",
  "author": "loczek",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --env=DIST=chromium --env=BROWSER=chrome --config webpack.dev.js --config webpack.iframe.js",
    "build": "yarn build:chromium:prod && yarn build:firefox:prod",
    "typecheck": "tsgo --noEmit -p ./tsconfig.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "start:chromium": "webpack --env=DIST=chromium --env=BROWSER=chrome --watch --config webpack.dev.js",
    "start:firefox": "webpack --env=DIST=firefox --env=BROWSER=firefox --watch --config webpack.dev.js",
    "build:chromium:prod": "webpack --mode production --env=DIST=chromium --env=BROWSER=chrome --config webpack.prod.js",
    "build:firefox:prod": "webpack --mode production --env=DIST=firefox --env=BROWSER=firefox --config webpack.prod.js",
    "build:chromium:dev": "webpack --env=DIST=chromium --env=BROWSER=chrome --config webpack.dev.js",
    "build:firefox:dev": "webpack --env=DIST=firefox --env=BROWSER=firefox --config webpack.dev.js",
    "package": "(cd dist/chromium && zip -r ../42fm_chromium_$(jq -r .version ../../package.json).zip . *) && (cd dist/firefox && zip -r ../42fm_firefox_$(jq -r .version ../../package.json).zip . *)",
    "zip-source": "git ls-files --recurse-submodules | tar caf ./source.tar.gz -T-"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@iconscout/react-unicons": "^2.2.5",
    "@js-temporal/polyfill": "^0.5.1",
    "date-fns": "^4.4.0",
    "html-loader": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-merge-refs": "^3.0.2",
    "socket.io-client": "^4.8.4",
    "styled-components": "^6.5.3",
    "typescript-eslint": "^8.71.1",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cooby/crx-load-script-webpack-plugin": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@styled/typescript-styled-plugin": "^1.1.1",
    "@swc/core": "^1.16.13",
    "@swc/plugin-styled-components": "^17.0.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-refresh": "^0.14.7",
    "@types/semver": "^7.8.0",
    "@types/stylis": "^4.2.7",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/webpack-env": "^1.18.8",
    "@types/youtube": "^0.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^10.12.0",
    "react-refresh": "^0.19.0",
    "semver": "^7.8.5",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "val-loader": "^6.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "packageManager": "yarn@4.1.1"
}
